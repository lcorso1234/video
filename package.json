{
  "name": "video",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:next:dev\" \"npm:electron:open\"",
    "dev:desktop": "npm run dev",
    "next:dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:open": "wait-on tcp:3006 && env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:dev": "npm run dev",
    "lint": "eslint",
    "test:brand": "node scripts/test-brand-backend.mjs",
    "test:auto-subtitles": "node scripts/test-auto-subtitles-e2e.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
